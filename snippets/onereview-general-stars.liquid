{%- comment -%}
  OneReview — partial implementation for custom theme integrations.
  The recommended way to add OneReview to a storefront is the app's theme app
  block: Shopify admin > Online Store > Themes > Customize > Add block >
  "General stars". Use this file only where the app block cannot be used. It
  may be missing features the app block has, it is not covered by automated
  tests, and it can lag behind the app. Requires the OneReview app to be
  installed on the store.
  https://github.com/OneReview/shopify-components

  Emits a small config + ratings blob for onereview-general-stars.js. The JS
  resolves product cards by their /products/<handle> links and injects star
  ratings; handles not in the "ratings" map are fetched at runtime from the app
  proxy (/apps/onereview/ratings), which covers recommendation carousels, the
  home page, and any products outside the Liquid render window.

  Render this ONCE per page — it emits an element with id="OneReviewData".
  It covers collection, search, home and product pages from that one include.

  Optional render parameters (same defaults as the app block):
    all_reviewed_products        - false to disable injection. Default true.
    empty_products               - true to show empty stars for unrated
                                   products. Default false.
    star_color                   - CSS color for the stars. Default #fdb731.
    custom_class_to_insert_block - stars are inserted before the first element
                                   in the card whose class contains this
                                   string. Default "price". Support use only.
  Depends on: assets/onereview-general-stars.js,
  assets/onereview-general-stars.css.
{%- endcomment -%}

<script id="OneReviewData" type="application/json">
  {
    "all_reviewed_products": {{ all_reviewed_products | json }},
    "empty_products": {{ empty_products | json }},
    "custom_class_to_insert_block": {{ custom_class_to_insert_block | default: 'price' | json }},
    "design_mode": {{ request.design_mode | json }},
    "page_type": {{ request.page_type | json }},
    "current_product_handle": {% if request.page_type == 'product' and product %}{{ product.handle | json }}{% else %}null{% endif %},
    "ratings": {
      {%- assign has_entries = false -%}
      {%- if collection and collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {%- liquid
            if product.metafields.review_summary.published.value == true and product.metafields.review_summary.average_rating != blank
              assign rating = product.metafields.review_summary.average_rating.value | round: 1
              assign review_count = product.metafields.review_summary.average_rating_review_count.value | default: '0'
            else
              assign rating = 0
              assign review_count = '0'
            endif
          -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {{ product.handle | json }}: {"rating": {{ rating }}, "count": {{ review_count | json }}}
          {%- assign has_entries = true -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if search.performed and search.results.size > 0 -%}
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
            {%- liquid
              if result.metafields.review_summary.published.value == true and result.metafields.review_summary.average_rating != blank
                assign rating = result.metafields.review_summary.average_rating.value | round: 1
                assign review_count = result.metafields.review_summary.average_rating_review_count.value | default: '0'
              else
                assign rating = 0
                assign review_count = '0'
              endif
            -%}
            {%- if has_entries -%},{%- endif -%}
            {{ result.handle | json }}: {"rating": {{ rating }}, "count": {{ review_count | json }}}
            {%- assign has_entries = true -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    }
  }
</script>

{{ 'onereview-general-stars.css' | asset_url | stylesheet_tag }}
<script src="{{ 'onereview-general-stars.js' | asset_url }}" defer></script>

<style>
    .onereview-stars {
        {%- if star_color != blank -%}
            --onereview-star-color: {{ star_color }};
        {%- endif -%}
    }
</style>
